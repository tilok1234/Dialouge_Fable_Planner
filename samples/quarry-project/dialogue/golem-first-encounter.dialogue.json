    {
      "id": "l1",
      "beatOrder": 1,
      "speakerId": "char_hornblende_golem",
      "text": {
        "key": "dlg_golem_enc_l1",
        "value": "You broke three seals to reach this floor. Each was a promise. Yours is the first step that did not keep it.",
        "lang": "en"
      },
      "humanEdited": false
    },
    {
      "id": "l2",
      "beatOrder": 2,
      "speakerId": "char_hornblende_golem",
      "text": {
        "key": "dlg_golem_enc_l2",
        "value": "You call it a quarry. A wound, left open, is what it is. And you carry the tools to open it further.",
        "lang": "en"
      },
      "humanEdited": false
    },
    {
      "id": "l3",
      "beatOrder": 3,
      "speakerId": "char_hornblende_golem",
      "text": {
        "key": "dlg_golem_enc_l3",
        "value": "Drop what you carry. Kneel. Then we will see what manner of thing entered here.",
        "lang": "en"
      },
      "humanEdited": false
    },
    {
      "id": "l4",
      "beatOrder": 4,
      "speakerId": "char_hornblende_golem",
      "text": {
        "key": "dlg_golem_enc_l4",
        "value": "You will not kneel. Then stand, and be weighed.",
        "lang": "en"
      },
