  "lines": [
    {
      "id": "l1",
      "beatOrder": 1,
      "speakerId": "char_bone_reliquary_king",
      "text": {
        "key": "dlg_rk_defeat_l1",
        "value": "There. The last ward is not broken, stranger. It is spent. Holding doors closed costs more than opening them ever will.",
        "lang": "en"
      },
      "humanEdited": false
    },
    {
      "id": "l2",
      "beatOrder": 2,
      "speakerId": "char_bone_reliquary_king",
      "text": {
        "key": "dlg_rk_defeat_l2",
        "value": "Please. There is nothing here that belongs to you. Only names, and the people who wore them.",
        "lang": "en"
      },
      "humanEdited": false
    },
    {
      "id": "l3",
      "beatOrder": 3,
      "speakerId": "char_bone_reliquary_king",
      "text": {
        "key": "dlg_rk_defeat_l3",
        "value": "The Continuance will gather me, as it gathers everyone. It is slower with the old ones. Use the quiet well.",
        "lang": "en"
      },
      "humanEdited": false
    },
    {
      "id": "l4",
      "beatOrder": 4,
      "speakerId": "char_bone_reliquary_king",
      "text": {
        "key": "dlg_rk_defeat_l4",
        "value": "And when you return — you will return — we will still ask you to leave in peace. It is a long ledger. I can wait.",
        "lang": "en"
      },
      "humanEdited": false
    }
  ],
