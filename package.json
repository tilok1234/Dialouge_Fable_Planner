{
  "name": "dialogue-foundry",
  "version": "0.0.0",
  "private": true,
  "description": "Dialogue Foundry — a local-first, model-independent game dialogue authoring system. Monorepo root.",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "pnpm -r run test",
    "validate-samples": "pnpm --filter @df/schemas run validate-samples",
    "emit-json-schema": "pnpm --filter @df/schemas run emit-json-schema",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run validate-samples"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
